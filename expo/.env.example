# Optional overrides for local Expo preview (gitignored .env).
# Standard portal pack: Google + Microsoft ON by default; Apple ON by default on iOS.
# Set to false only to hide a button. OAuth completion still needs Supabase provider client IDs/secrets.
# EXPO_PUBLIC_GOOGLE_SIGN_IN=false
# EXPO_PUBLIC_MICROSOFT_SIGN_IN=false
# EXPO_PUBLIC_APPLE_SIGN_IN=true

# Optional local/demo only: skip login and enter admin preview.
# Never set true for production users. Default / production = false.
# EXPO_PUBLIC_AUTH_BYPASS=true
