{
  "expo": {
    "name": "My Realtor App",
    "slug": "my-realtor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["rork-app", "myrealtorapp"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.myrealtor",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of a property or your portrait to add it to your app.",
        "NSPhotoLibraryUsageDescription": "Choose listing photos, your portrait and your app icon from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Save property photos and documents from your app to your photo library.",
        "NSContactsUsageDescription": "Import your existing clients from your contacts so you don't have to type them in again.",
        "NSFaceIDUsageDescription": "Unlock your saved sign-in details.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.myrealtor",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose listing photos, your portrait and your app icon from your photo library.",
          "cameraPermission": "Take a photo of a property or your portrait to add it to your app."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Import your existing clients from your contacts so you don't have to type them in again."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D2A343"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "jtaylor537",
    "extra": {
      "eas": {
        "projectId": "b715c6fd-84ee-4f15-86c4-eba1467262c4"
      }
    }
  }
}
